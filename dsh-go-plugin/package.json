{
  "name": "local-examboost",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "ExamBoost 综合备考 v2：画像引导/三级溯源/FSRS-5/资料中枢——读独立软件同一份数据，dsh 原生深度优化",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "ExamBoost 备考",
      "en": "ExamBoost"
    },
    "icon": "book",
    "wants": [
      "draft",
      "message"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "eb-ask",
          "label": {
            "zh": "抽一题",
            "en": "Quiz me"
          },
          "icon": "todo"
        },
        {
          "id": "eb-explain",
          "label": {
            "zh": "讲这题",
            "en": "Explain"
          },
          "icon": "lightbulb"
        }
      ],
      "message.actions": [
        {
          "id": "eb-log",
          "label": {
            "zh": "记入错题本",
            "en": "Log mistake"
          },
          "icon": "note"
        }
      ],
      "composer.strip": [
        {
          "id": "eb-strip",
          "icon": "alarm",
          "panel": "eb-dash"
        }
      ],
      "panels": [
        {
          "id": "eb-dash",
          "title": {
            "zh": "学习看板",
            "en": "Dashboard"
          },
          "icon": "chart"
        },
        {
          "id": "eb-mistakes",
          "title": {
            "zh": "错题本",
            "en": "Mistakes"
          },
          "icon": "note"
        },
        {
          "id": "eb-review",
          "title": {
            "zh": "今日复习",
            "en": "Review"
          },
          "icon": "alarm"
        }
      ]
    }
  }
}